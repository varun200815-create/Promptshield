{
  "name": "promptshield-ai",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "postinstall": "node -e \"import('node:fs').then(fs=>fs.rmSync('node_modules/@rollup/rollup-win32-x64-msvc',{recursive:true,force:true}))\"",
    "dev": "concurrently -k -n WEB,API -c blue,green \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm test --workspace backend",
    "start": "npm run dev",
    "push:github": "node scripts/push-to-github.mjs",
    "github:push": "node scripts/push-to-github.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.24.0"
  }
}
